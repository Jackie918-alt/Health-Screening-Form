# Copy to `.env.local` for development, and set the same values in Vercel
# (Project → Settings → Environment Variables) for production.
#
# After filling these in, verify the connection with:  npm run supabase:check

# ── Storage (required) ──────────────────────────────────────────────────────
# Supabase → Project Settings → API
SUPABASE_URL=

# The SERVICE ROLE key, not the anon key. It bypasses row-level security, so it
# is server-side only — never expose it and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Without both of the above the survey refuses submissions and the admin page
# explains what is missing. That is deliberate: a survey that accepts answers
# it cannot store is worse than one that is plainly switched off.

# ── Admin access (required) ─────────────────────────────────────────────────
# The shared password for /admin. Agents filling in the survey need nothing.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; changing it signs
# every admin out. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Development only ────────────────────────────────────────────────────────
# Set to 1 to store responses in a local file instead of Supabase, so the app
# runs on a laptop with no credentials. Never set this in production — a
# serverless host discards the file.
# ALLOW_FILE_STORE=1
