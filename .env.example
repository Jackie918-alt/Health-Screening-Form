# Copy to `.env.local` for development, and set the same values in Vercel
# (Project → Settings → Environment Variables) for production.

# ── Admin access ────────────────────────────────────────────────────────────
# The shared password for /admin. Agents filling in the survey need nothing.
ADMIN_PASSWORD=

# Signs the admin session cookie. Any long random string; changing it signs
# every admin out. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ── Storage ─────────────────────────────────────────────────────────────────
# Leave both blank to store responses in a local file (development only —
# a Vercel deployment with these unset LOSES every response).
# Set both to switch to Supabase; no code change or redeploy of code needed.
# Supabase → Project Settings → API
SUPABASE_URL=
# The SERVICE ROLE key, not the anon key. Server-side only — never expose it,
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
